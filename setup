#!/usr/bin/env bash
# By: TechGenius
# Setup script - instala cloudflared y configura el comando cloudflare

OS=$(uname -o)
ARCH=$(uname -m)

# Colores
GREEN="\033[1;32m"
RED="\033[1;31m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
WHITE="\033[1;37m"
RESET="\033[00m"

# Detectar Termux primero que todo
if [[ -n "$TERMUX_VERSION" || "$PREFIX" == *"termux"* || "$HOME" == *"com.termux"* ]]; then
  IS_TERMUX=true
  BIN_PATH="$PREFIX/bin"
  SHARE_PATH="$PREFIX/share"
else
  IS_TERMUX=false
  BIN_PATH="/usr/local/bin"
  SHARE_PATH="/usr/share"
fi

banner_setup() {
  printf "${YELLOW}"
  printf "  ████████╗███████╗ ██████╗██╗  ██╗\n"
  printf "  ╚══██╔══╝██╔════╝██╔════╝██║  ██║\n"
  printf "     ██║   █████╗  ██║     ███████║\n"
  printf "     ██║   ██╔══╝  ██║     ██╔══██║\n"
  printf "     ██║   ███████╗╚██████╗██║  ██║\n"
  printf "     ╚═╝   ╚══════╝ ╚═════╝╚═╝  ╚═╝\n"
  printf "  ██████╗ ███████╗███╗   ██╗██╗██╗   ██╗███████╗\n"
  printf "  ██╔════╝██╔════╝████╗  ██║██║██║   ██║██╔════╝\n"
  printf "  ██║  ███╗█████╗  ██╔██╗ ██║██║██║   ██║███████╗\n"
  printf "  ██║   ██║██╔══╝  ██║╚██╗██║██║██║   ██║╚════██║\n"
  printf "  ╚██████╔╝███████╗██║ ╚████║██║╚██████╔╝███████║\n"
  printf "   ╚═════╝ ╚══════╝╚═╝  ╚═══╝╚═╝ ╚═════╝ ╚══════╝\n"
  printf "${RESET}\n"
  printf "${BLUE}  [_____________ TechGenius Setup _____________]${RESET}\n\n"
  if $IS_TERMUX; then
    printf "${YELLOW}  Modo: Termux${RESET}\n\n"
  else
    printf "${YELLOW}  Modo: Linux${RESET}\n\n"
  fi
}

check_internet() {
  printf "${BLUE}  Verificando conexión a internet...${RESET}\n"
  curl -s --max-time 5 google.com > /dev/null 2>&1
  if [[ $? != 0 ]]; then
    printf "${RED}  [!] Sin conexión a internet. Verifica tu red.${RESET}\n"
    exit 1
  fi
  printf "${GREEN}  [✓] Conexión OK${RESET}\n"
}

check_permissions() {
  # Termux nunca necesita root ni sudo
  if $IS_TERMUX; then
    printf "${GREEN}  [✓] Termux detectado, sin necesidad de root${RESET}\n"
    return 0
  fi

  # Windows
  if [[ ${OS^^} == *'MSYS'* || ${OS^^} == *'WINDOWS'* ]]; then
    adminPerm=$(net user administrator | grep active | awk '{print $NF}')
    case ${adminPerm,,} in
      yes) opposite="no" ;;
      no)  opposite="yes" ;;
      *)   printf "${RED}  [!] No es posible continuar.${RESET}\n"; exit 1 ;;
    esac
    net user administrator /active:${opposite} > /dev/null 2>&1
    adminPerm=$(net user administrator | grep active | awk '{print $NF}')
    if [[ ${adminPerm,,} != "${opposite}" ]]; then
      printf "${RED}  [!] Ejecuta como Administrador.${RESET}\n"
      exit 1
    fi
  # Linux normal
  elif [[ ${OS^^} == *'LINUX'* ]]; then
    if [[ "$EUID" -ne 0 ]]; then
      printf "${RED}  [!] Ejecuta como root: sudo bash setup${RESET}\n"
      exit 1
    fi
    printf "${GREEN}  [✓] Permisos root OK${RESET}\n"
  fi
}

# Funcion de descarga con reintentos y fallback
download_file() {
  local URL=$1
  local OUTPUT=$2
  local INTENTOS=3

  # Intentar con wget
  if hash wget 2>/dev/null; then
    for i in $(seq 1 $INTENTOS); do
      printf "${BLUE}  Descargando... intento $i/$INTENTOS${RESET}\n"
      wget --tries=3 --timeout=30 "$URL" -O "$OUTPUT"
      if [[ $? == 0 && -s "$OUTPUT" ]]; then
        return 0
      fi
      sleep 2
    done
  fi

  # Fallback a curl
  if hash curl 2>/dev/null; then
    printf "${YELLOW}  wget falló, intentando con curl...${RESET}\n"
    for i in $(seq 1 $INTENTOS); do
      printf "${BLUE}  Descargando... intento $i/$INTENTOS${RESET}\n"
      curl -L --retry 3 --connect-timeout 30 "$URL" -o "$OUTPUT"
      if [[ $? == 0 && -s "$OUTPUT" ]]; then
        return 0
      fi
      sleep 2
    done
  fi

  return 1
}

install_cloudflared() {
    printf "\n${BLUE}  Verificando cloudflared...${RESET}\n"

  # Asegurar herramientas de descarga en Termux
  if $IS_TERMUX; then
    if ! hash wget 2>/dev/null; then
      printf "${YELLOW}  Instalando wget...${RESET}\n"
      pkg install wget -y > /dev/null 2>&1
    fi
    if ! hash curl 2>/dev/null; then
      printf "${YELLOW}  Instalando curl...${RESET}\n"
      pkg install curl -y > /dev/null 2>&1
    fi
  fi

  if $IS_TERMUX; then
    # En Termux siempre verificar que sea la version correcta
    local CURRENT
    CURRENT=$(cloudflared --version 2>&1 | grep -o '[0-9]*\.[0-9]*\.[0-9]*' | head -1)

    if [[ "$CURRENT" == "2021.10.3" ]]; then
      printf "${GREEN}  [✓] cloudflared versión correcta: $CURRENT${RESET}\n"
      chmod 555 "$BIN_PATH/cloudflared"
      return 0
    else
      printf "${YELLOW}  [!] Versión incorrecta ($CURRENT), instalando 2021.10.3...${RESET}\n"

      # Desinstalar version actual
      pkg uninstall cloudflared -y > /dev/null 2>&1
      rm -f "$BIN_PATH/cloudflared" 2>/dev/null
      rm -f $HOME/cloudflared 2>/dev/null

      local VERSION="2021.10.3"
      case $ARCH in
        aarch64|armv8)
          URL="https://github.com/cloudflare/cloudflared/releases/download/${VERSION}/cloudflared-linux-arm64" ;;
        armv7l|aarch32)
          URL="https://github.com/cloudflare/cloudflared/releases/download/${VERSION}/cloudflared-linux-arm" ;;
        x86_64|amd64)
          URL="https://github.com/cloudflare/cloudflared/releases/download/${VERSION}/cloudflared-linux-amd64" ;;
        i686|x86)
          URL="https://github.com/cloudflare/cloudflared/releases/download/${VERSION}/cloudflared-linux-386" ;;
        *)
          printf "${RED}  [!] Arquitectura no soportada: $ARCH${RESET}\n"; exit 1 ;;
      esac

      # Descargar con reintentos y fallback
      cd $HOME
      download_file "$URL" "cloudflared"
      if [[ $? != 0 ]]; then
        printf "${RED}  [!] Falló la descarga. Verifica tu conexión.${RESET}\n"
        exit 1
      fi

      chmod +x cloudflared
      mv cloudflared "$BIN_PATH/cloudflared"
      chmod 555 "$BIN_PATH/cloudflared"
    fi

  else
    # Linux normal usa la ultima version
    if hash cloudflared 2>/dev/null; then
      ver=$(cloudflared --version 2>&1)
      if [[ "$ver" == *"version"* ]]; then
        printf "${GREEN}  [✓] cloudflared ya instalado: $ver${RESET}\n"
        return 0
      else
        printf "${YELLOW}  [!] cloudflared corrupto, reinstalando...${RESET}\n"
        rm -f "$BIN_PATH/cloudflared" 2>/dev/null
      fi
    fi

    case $ARCH in
      x86_64)  URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64" ;;
      aarch64) URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64" ;;
      armv7l)  URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm" ;;
      i686)    URL="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-386" ;;
      *)       printf "${RED}  [!] Arquitectura no soportada: $ARCH${RESET}\n"; exit 1 ;;
    esac

    printf "${BLUE}  Descargando cloudflared...${RESET}\n"
    download_file "$URL" "$BIN_PATH/cloudflared"
    if [[ $? != 0 ]]; then
      printf "${RED}  [!] Falló la descarga. Verifica tu conexión.${RESET}\n"
      exit 1
    fi
    chmod +x "$BIN_PATH/cloudflared"
  fi

  # Verificar instalacion final
  if hash cloudflared 2>/dev/null; then
    printf "${GREEN}  [✓] cloudflared instalado: $(cloudflared --version)${RESET}\n"
  else
    printf "${RED}  [!] Falló la instalación de cloudflared${RESET}\n"
    exit 1
  fi
}

install_cloudflare_cmd() {
  printf "\n${BLUE}  Configurando comando 'cloudflare'...${RESET}\n"

  # Buscar el archivo cloudflare en varias ubicaciones
  if [[ -f "$(pwd)/cloudflare" ]]; then
    CLOUDFLARE_FILE="$(pwd)/cloudflare"
  elif [[ -f "$HOME/CloudFlare-Build/cloudflare" ]]; then
    CLOUDFLARE_FILE="$HOME/CloudFlare-Build/cloudflare"
  elif [[ -f "$(dirname $0)/cloudflare" ]]; then
    CLOUDFLARE_FILE="$(dirname $0)/cloudflare"
  else
    printf "${RED}  [!] Archivo 'cloudflare' no encontrado.${RESET}\n"
    printf "${YELLOW}  Asegúrate de que 'cloudflare' y 'setup' estén juntos.${RESET}\n"
    exit 1
  fi

  # Corregir CRLF antes de copiar
  sed -i 's/\r//' "$CLOUDFLARE_FILE"

  cp "$CLOUDFLARE_FILE" "$BIN_PATH/cloudflare"
  chmod +x "$BIN_PATH/cloudflare"

  # Corregir CRLF en el destino también
  sed -i 's/\r//' "$BIN_PATH/cloudflare"

  printf "${GREEN}  [✓] Comando instalado en $BIN_PATH/cloudflare${RESET}\n"
}

main() {
  clear
  banner_setup
  check_permissions
  check_internet

  printf "\n${YELLOW}  Iniciando instalación...${RESET}\n"

  install_cloudflared
  install_cloudflare_cmd

  printf "\n${GREEN}  ╔══════════════════════════════════════╗${RESET}\n"
  printf "${GREEN}  ║   Instalación completada con éxito!  ║${RESET}\n"
  printf "${GREEN}  ╚══════════════════════════════════════╝${RESET}\n\n"
  printf "${WHITE}  Usa: ${YELLOW}cloudflare --help${WHITE} para ver el menú${RESET}\n\n"
}

main